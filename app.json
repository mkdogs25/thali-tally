{
  "expo": {
    "name": "Thali Tally",
    "slug": "thali-tally",
    "scheme": "thalitally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.thalitally",
      "infoPlist": {
        "NSMotionUsageDescription": "Thali Tally reads your step count to estimate the calories you burn.",
        "NSCameraUsageDescription": "Thali Tally uses the camera to photograph your food and scan barcodes."
      }
    },
    "android": {
      "package": "app.thalitally",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Thali Tally uses the camera to photograph your food and scan barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Thali Tally uses the camera to photograph your food."
        }
      ],
      "expo-notifications",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
